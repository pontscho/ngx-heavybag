^/remote/fgt_lang
^/remote/login
^/\+cscoe\+/
^/bin/sh$
^/api/v2/cmdb/system/admin/admin
^/HNAP1
^/SDK/webLanguage
^/boaform/
^/cgi-bin/
^/actuator
^/geoserver
^/solr/
^/manager/(html|text)
^/login\.action$
^/struts
^/v2/_catalog$
^/_all_dbs$
^/dns-query
^/resolve\?
^/scripts/WPnBr\.dll$
(^|/)Telerik\.Web\.UI\.WebResource\.axd
(^|/)GponForm/
^/\+CSCOL\+/
(^|/)developmentserver/metadatauploader
^/config/getuser
^/dana-na/
^/dana-cached/
^/mgmt/tm/util/bash
^/api/sonicos/
(^|/)mifs/
^/CFIDE/
^/sitecore/
^/RDWeb/
^/evox/about
(^|/)etc/passwd

# ---- credential / config / infra-API leaks --------------------------------
# Config/IaC/secret files are never served at this edge (baseline serves only
# /, /app.*, static assets), so blanket extension rules for config-only formats
# (.yml/.yaml/.properties/.tfstate/.tfvars) have no false-positive surface here
# -- validated by the work-stream B detect FP gate. Distinctive .json/dotfile
# secret stores are enumerated instead (a blanket .json rule would hit the
# /app.json baseline). 2026-06 gap-loop, extended.
(^|/)aws/credentials
^/credentials$
^/.*\.env$
^/.*\.ya?ml$
^/.*\.properties$
^/.*\.tfstate
^/.*\.tfvars$
(^|/)appsettings(\.[A-Za-z]+)?\.json$
(^|/)credentials\.json$
(^|/)client_secrets\.json$
(^|/)secrets\.json$
(^|/)auth\.json$
(^|/)composer\.(json|lock)$
(^|/)sftp-config\.json$
(^|/)settings\.json$
(^|/)local\.settings\.json$
(^|/)\.runtimeconfig\.json$
(^|/)env\.(json|txt)$
(^|/)connectionstrings\.config$
^/Web\.(Debug|Release)\.config$
^/web\.config[~.]
(^|/)settings\.py$
(^|/)global\.asax$
(^|/)\.npmrc$
(^|/)\.netrc$
(^|/)\.htpasswd$
(^|/)\.dockerenv$
(^|/)\.kube/
(^|/)\.composer/
(^|/)\.docker/config\.json$
(^|/)config/credentials
(^|/)config/master\.key$
(^|/)storage/logs/
^/error\.log$
^/env$
(^|/)containers/json
^/server-status
^/server-info$
^/nginx_status$
^/druid/

# ---- 2026-11 upstream sync (CRS restricted files, dev-tool dotfiles) --------
# Matching is against r->uri (path only): the query-string form
# /?rest_route=/batch/v1 cannot be expressed here (it is in args.list).
# Already covered, not re-added: /wp-json/batch/v1 and
# /wp-content/plugins/kapibala_plugin/ (^/wp-), dbconn.php (.php catch-all),
# bitbucket-pipelines.yml / kustomization.yml / Chart.yaml (.ya?ml rule).
(^|/)\.claude(/|$)
(^|/)\.pypirc$
(^|/)\.pnpmrc$
(^|/)\.pnpm-store/
(^|/)\.oscrc$
(^|/)\.osc_cookiejar$
(^|/)\.erlang\.cookie$
(^|/)WS_FTP\.log$
(^|/)remix\.config\.js$
(^|/)netlify\.toml$
(^|/)vercel\.json$

# ---- 2026-11 live-log mining (edge v, 2026-06..11) --------------------------
# Probe families seen from 20-200+ IPs each with 0% 200-rate on the live edge
# (/tmp/logmine/report.md s2). The edge legitimately serves /app.css, /app.json,
# /app-*.js, /hmr-runtime.js, /api/{health,users,session,login}, /safranek/*,
# /parastable*, /sdcpp/*, /static/renderpark.*, /fonts/*: NONE of the patterns
# below match those (checked with a PCRE sanity run), so bare /app.js,
# /index.js, /app.json and generic app routes (/admin, /graphql, /mcp, ...) are
# deliberately NOT listed. Already covered, not re-added: xmlrpc.php (.php
# catch-all), wlwmanifest, /etc/passwd, /.env* variants (incl. %2eenv, which
# nginx decodes), .claude, *.ya?ml, *.properties, .npmrc. Plain `..` segments never reach r->uri (nginx merges them); only the
# double-encoded `..%2f` residue is matchable.
# cloud / CLI credential stores
(^|/)(\.boto|\.s3cfg|\.amplifyrc|credentials\.ini|aws-exports\.js)$
(^|/)\.config/gcloud/
(^|/)application_default_credentials\.json$
# GCP / Firebase service-account key family
(^|/)(service[-_]?account|google-(service-account|credentials|services)|gcp-(key|credentials|service)|gc-service|serviceAccountKey|firebase[-_a-z0-9]*|sa|key|push_config)\.json$
# container / PaaS / IaC config
(^|/)Dockerfile$
(^|/)Dockerrun\.aws\.json$
(^|/)vendor/composer/installed\.json$
(^|/)railway\.json$
^/.*\.toml$
(^|/)supabase/config\.toml$
# client-config JS leaks (exact file names only)
(^|/)(config|env|env-config|runtime-config|app\.config|firebaseConfig|firebase-config|credentials)\.js$
# WordPress under arbitrary prefixes (/blog/wp-json/..., /wp/wp-includes/...)
(^|/)wp-(json|admin|includes|content)/
# Spring actuator under a prefix (/api/actuator/env)
(^|/)actuator(/|$)
# Vite dev-server LFI / RSC probes
^/@fs/
^/__vite
# LFI / traversal residue (proc, k8s secrets, double-encoded ..%2f)
(^|/)proc/self/
(^|/)var/run/secrets/
\.\.%(25)?(2f|5c)
# private keys / TLS material
^/.*\.(key|pem)$
(^|/)id_(rsa|dsa|ecdsa|ed25519)
(^|/)private[-_]?key
# shell / tool dotfiles
(^|/)\.(bashrc|zshrc|bash_profile|profile|dockercfg|htaccess|firebaserc)$
(^|/)\.dev\.vars
(^|/)\.terraform
(^|/)\.idea/
(^|/)rclone\.conf$
# AI-tool config / secret stores
(^|/)\.(anthropic|cursor|openai|aider)(/|$|\.)
# Astro source-map probes
\.astro\.mjs\.map$
# admin-API / file-read probes
^/api/(console/api_server|fs/read|system/fileView)
# API docs not served at this edge
(^|/)openapi\.json$
(^|/)swagger([-_.]|/|$)

