# Go standard-library HTTP client
Go-http-client
# Python requests library
python-requests
# Python aiohttp library
aiohttp
# curl / libcurl (also matches grpcurl, harmless)
curl

# -- 2026-11 upstream sync (OWASP CRS + device-detector Security Checker) ----
